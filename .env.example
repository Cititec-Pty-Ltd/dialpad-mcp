# Dialpad API key, sent as "Authorization: Bearer <key>". Used by stdio and by
# HTTP only when AUTH_MODE=env. Create it in Dialpad Admin Settings > My
# Company > Authentication > API keys. Number tools need a company admin key.
# The gateway Compose service does not load this; gateway mode requires the
# X-Dialpad-Api-Key header instead.
DIALPAD_API_KEY=

# Transport: stdio (default) or http
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8080
# Bind address. With a real CONDUIT_S2S_SECRET, MCP_HTTP_HOST is honored and
# an unset value stays 0.0.0.0. With no secret, MCP_ALLOW_INSECURE_DEV=1
# ignores this and binds 127.0.0.1.
# MCP_HTTP_HOST=127.0.0.1

# Required to start the HTTP transport. The process exits when this is empty
# or a known placeholder. Generate with: openssl rand -hex 32
CONDUIT_S2S_SECRET=

# Local development only: start HTTP without CONDUIT_S2S_SECRET, bound to
# 127.0.0.1, with no X-Gateway-S2S check.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-Dialpad-Api-Key header; no env fallback). Stdio ignores this.
# AUTH_MODE=env

# Log level: debug, info, warn, error
LOG_LEVEL=info
